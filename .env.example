# --- Supabase ---
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
# ATTENTION : cette clé donne un accès total à la base, sans RLS.
# Ne jamais l'exposer côté navigateur, uniquement dans les variables serveur (Vercel).
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# --- KomiPay ---
# Créer un compte sur https://www.komipay.com (ou sandbox pour tester)
# Paramètres > Générer API, une fois ton KYC validé
KOMIPAY_LOGIN=xxxxxxxx
KOMIPAY_PASSWORD=xxxxxxxx
KOMIPAY_API_KEY=xxxxxxxx
# "sandbox" pour tester, "live" une fois prêt pour l'événement
KOMIPAY_ENV=sandbox
